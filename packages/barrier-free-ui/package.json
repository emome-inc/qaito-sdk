{
  "name": "@qaito/barrier-free-ui",
  "version": "0.1.1",
  "description": "Qaito バリアフリー UI（CSS トークンと React 部品。文字の大きさ 小・中・大、ダーク、テーマ）。TypeScript のソースのまま配る（Next.js は transpilePackages に入れる）",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emome-inc/qaito-sdk.git",
    "directory": "packages/barrier-free-ui"
  },
  "exports": {
    "./css": "./src/css/index.css",
    "./css/*": "./src/css/*",
    "./react": "./src/react/index.ts",
    "./kana": "./src/react/kana.ts",
    "./chart-types": "./src/react/chart/chart-types.ts",
    "./icons": "./src/icons/index.tsx"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.575.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
